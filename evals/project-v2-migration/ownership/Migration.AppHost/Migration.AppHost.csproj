  <ItemGroup>
    <ProjectReference Include="../Migration.Api/Migration.Api.csproj" AspireProjectMetadataTypeName="CatalogApi" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Migration.Shared/Migration.Shared.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
