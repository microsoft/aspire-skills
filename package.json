{
  "name": "aspire-skills",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "version:dev": "node scripts/version-development.mjs",
    "test": "node --test tests/*.test.mjs tests/aspireify/*.test.mjs",
    "canvas:sync": "node scripts/sync-canvas-assets.mjs",
    "canvas:check": "node scripts/sync-canvas-assets.mjs --check",
