---
import { Code } from "astro-expressive-code/components";
import { Icon } from "astro-icon/components";
import VendorBadge from "./VendorBadge.astro";
import type { InstallSurface } from "../lib/site-data";

interface Props {
  surfaces: InstallSurface[];
}

const { surfaces } = Astro.props;
---

<section id="install" class="glass-card rounded-2xl p-4 shadow-sm sm:p-5" aria-labelledby="install-heading">
  <div class="mb-5">
    <div>
      <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-aspire-purple dark:text-aspire-muted">
        <Icon name="lucide:download" class="h-4 w-4" />
        Start here
      </p>
      <h2 id="install-heading" class="mt-1 text-2xl font-bold tracking-tight text-aspire-black dark:text-white">Install in your agent CLI</h2>
    </div>
  </div>

  <div class="mb-5 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap" role="tablist" aria-label="Agent host install options">
    {surfaces.map((surface, index) => (
      <button
        type="button"
        role="tab"
        class="install-tab inline-flex min-w-0 items-center justify-start gap-2 rounded-xl border border-aspire-primary/15 bg-white px-2.5 py-2 text-[0.8rem] font-semibold text-slate-700 transition hover:border-aspire-primary/50 hover:text-aspire-purple dark:border-white/10 dark:bg-white/[0.06] dark:text-slate-200 dark:hover:text-white sm:w-auto sm:px-3 sm:text-sm"
        id={`install-tab-${surface.id}`}
        data-install-tab={surface.id}
        data-active={index === 0 ? "true" : "false"}
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`install-panel-${surface.id}`}
      >
        <VendorBadge icon={surface.icon} label={surface.name} compact />
        <span class="min-w-0 truncate">{surface.shortName}</span>
      </button>
    ))}
  </div>

  <div>
    {surfaces.map((surface, index) => (
      <div
        id={`install-panel-${surface.id}`}
        role="tabpanel"
        data-install-panel={surface.id}
        aria-labelledby={`install-tab-${surface.id}`}
        hidden={index !== 0}
      >
        <div class="mb-4 rounded-xl border border-aspire-primary/10 bg-white p-4 dark:border-white/10 dark:bg-white/[0.06]">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="text-xl font-bold text-aspire-black dark:text-white">{surface.name}</h3>
              <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-200">{surface.detail}</p>
            </div>
            <span class="inline-flex w-fit shrink-0 items-center gap-1.5 rounded-full bg-aspire-muted px-3 py-1 text-xs font-semibold text-aspire-purple dark:bg-white/10 dark:text-aspire-muted">
              <Icon name="lucide:plug" class="h-3.5 w-3.5" />
              {surface.status}
            </span>
          </div>
        </div>

        <div class="install-terminal">
          <Code code={surface.command} lang="bash" title={surface.title} />
        </div>

        <ul class="mt-4 grid gap-2 text-sm text-slate-700 dark:text-slate-200">
          {surface.notes.map((note) => (
            <li class="flex gap-2">
              <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-aspire-cyan" />
              <span>{note}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = Array.from(document.querySelectorAll("[data-install-tab]"));
    const panels = Array.from(document.querySelectorAll("[data-install-panel]"));
    const installParam = "install";
    const storageKey = "aspire-skills-install-tab";
    const tabIds = tabs.map((tab) => tab.getAttribute("data-install-tab")).filter(Boolean);

    if (tabs.length === 0) {
      return;
    }

    const normalizeId = (id) => id?.trim().toLowerCase();
    const isKnownTab = (id) => Boolean(id && tabIds.includes(id));

    const getQuerySelection = () => {
      const value = normalizeId(new URL(window.location.href).searchParams.get(installParam));
      return isKnownTab(value) ? value : undefined;
    };

    const getStoredSelection = () => {
      try {
        const value = normalizeId(localStorage.getItem(storageKey));
        return isKnownTab(value) ? value : undefined;
      } catch {
        return undefined;
      }
    };

    const persistSelection = (id) => {
      try {
        localStorage.setItem(storageKey, id);
      } catch {
        // Ignore storage failures in private browsing or locked-down environments.
      }
    };

    const updateUrlSelection = (id) => {
      const url = new URL(window.location.href);
      url.searchParams.set(installParam, id);
      window.history.replaceState({}, "", url);
    };

    const activate = (id, options = {}) => {
      const { focusActiveTab = false, persist = false, updateUrl = false } = options;
      for (const tab of tabs) {
        const isActive = tab.getAttribute("data-install-tab") === id;
        tab.setAttribute("data-active", isActive ? "true" : "false");
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.setAttribute("tabindex", isActive ? "0" : "-1");
        if (isActive && focusActiveTab) {
          tab.focus();
        }
      }

      for (const panel of panels) {
        panel.hidden = panel.getAttribute("data-install-panel") !== id;
      }

      if (persist) {
        persistSelection(id);
      }

      if (updateUrl) {
        updateUrlSelection(id);
      }
    };

    const querySelection = getQuerySelection();
    const initialId = querySelection ?? getStoredSelection() ?? tabIds[0];
    activate(initialId, { persist: Boolean(querySelection) });

    for (const tab of tabs) {
      tab.setAttribute("tabindex", tab.getAttribute("aria-selected") === "true" ? "0" : "-1");
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-install-tab");
        if (id) {
          activate(id, { persist: true, updateUrl: true });
        }
      });

      tab.addEventListener("keydown", (event) => {
        const key = event.key;
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(key)) {
          return;
        }

        event.preventDefault();
        const currentIndex = tabs.indexOf(tab);
        const nextIndex =
          key === "Home"
            ? 0
            : key === "End"
              ? tabs.length - 1
              : key === "ArrowRight" || key === "ArrowDown"
                ? (currentIndex + 1) % tabs.length
                : (currentIndex - 1 + tabs.length) % tabs.length;
        const id = tabs[nextIndex].getAttribute("data-install-tab");
        if (id) {
          activate(id, { focusActiveTab: true, persist: true, updateUrl: true });
        }
      });
    }
  })();
</script>
