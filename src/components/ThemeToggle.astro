<button
  type="button"
  class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded-xl border border-aspire-primary/20 bg-white text-aspire-purple transition hover:border-aspire-primary dark:border-white/15 dark:bg-white/10 dark:text-aspire-muted dark:hover:bg-white/15"
  data-theme-toggle
  aria-label="Toggle color theme"
>
  <svg class="sun-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="moon-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 7 7 0 1 0 20.5 14.5Z" />
  </svg>
</button>

<script is:inline>
  (() => {
    const storageKey = "aspire-skills-theme";
    const button = document.querySelector("[data-theme-toggle]");

    if (!button) {
      return;
    }

    const updateLabel = () => {
      const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      button.setAttribute("aria-label", `Switch to ${current === "dark" ? "light" : "dark"} theme`);
      button.setAttribute("title", `Switch to ${current === "dark" ? "light" : "dark"} theme`);
    };

    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;

      try {
        localStorage.setItem(storageKey, next);
      } catch (error) {
        console.warn("Unable to persist Aspire skills theme preference.", error);
      }

      updateLabel();
    });

    updateLabel();
  })();
</script>
