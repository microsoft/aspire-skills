---
import { Icon } from "astro-icon/components";

interface Props {
  icon: "aspire" | "claude" | "copilot" | "cursor" | "gemini" | "github" | "ollama" | "openai" | "opencode";
  label: string;
  compact?: boolean;
}

const { icon, label, compact = false } = Astro.props;

const iconifyNames = {
  claude: "logos:claude-icon",
  copilot: "logos:github-copilot",
  cursor: "simple-icons:cursor",
  gemini: "logos:google-gemini",
  github: "simple-icons:github",
  ollama: "simple-icons:ollama",
  openai: "logos:openai-icon"
};
const compactIconifyNames = {
  ...iconifyNames,
  gemini: "simple-icons:googlegemini"
};
const imageSources = {
  aspire: `${import.meta.env.BASE_URL}brand/aspire-logo-256.svg`,
  opencode: `${import.meta.env.BASE_URL}brand/opencode-logo.svg`
};

const iconSet = compact ? compactIconifyNames : iconifyNames;
const iconifyName = icon in iconSet ? iconSet[icon as keyof typeof iconSet] : undefined;
const imageSource = icon in imageSources ? imageSources[icon as keyof typeof imageSources] : undefined;
const isWide = !compact && (icon === "gemini" || icon === "opencode");
const currentColorIconClasses = {
  cursor: "text-aspire-black dark:text-white",
  gemini: "text-aspire-purple dark:text-aspire-muted",
  github: "text-aspire-black dark:text-white",
  ollama: "text-aspire-black dark:text-white"
};
const currentColorClass = icon in currentColorIconClasses ? currentColorIconClasses[icon as keyof typeof currentColorIconClasses] : "";
const toneClasses = {
  aspire: "border-aspire-purple/20 bg-[#f4f0ff] text-aspire-purple dark:border-aspire-muted/25 dark:bg-aspire-primary/20 dark:text-aspire-muted",
  claude: "border-orange-200 bg-orange-50 text-orange-700 dark:border-orange-300/20 dark:bg-orange-400/15 dark:text-orange-200",
  copilot: "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-white/15 dark:bg-white/10 dark:text-white",
  cursor: "border-slate-300 bg-slate-100 text-aspire-black dark:border-white/15 dark:bg-white/10 dark:text-white",
  gemini: "border-blue-200 bg-blue-50 text-aspire-blue dark:border-blue-300/20 dark:bg-blue-400/15 dark:text-blue-200",
  github: "border-slate-300 bg-slate-100 text-aspire-black dark:border-white/15 dark:bg-white/10 dark:text-white",
  ollama: "border-yellow-200 bg-yellow-50 text-aspire-yellow dark:border-yellow-300/20 dark:bg-yellow-400/15 dark:text-yellow-200",
  openai: "border-teal-200 bg-teal-50 text-teal-700 dark:border-teal-300/20 dark:bg-teal-400/15 dark:text-teal-200",
  opencode: "border-fuchsia-200 bg-fuchsia-50 text-aspire-magenta dark:border-fuchsia-300/20 dark:bg-fuchsia-400/15 dark:text-fuchsia-200"
};
const toneClass = toneClasses[icon];
---

<span
  class:list={[
    "vendor-badge inline-flex shrink-0 items-center justify-center border transition",
    toneClass,
    compact ? "h-8 w-8 rounded-lg" : "h-10 rounded-xl",
    isWide ? "w-24 px-2" : compact ? "w-8" : "w-10"
  ]}
  data-vendor-icon={icon}
  aria-hidden="true"
>
  {iconifyName && (
    <Icon
      name={iconifyName}
      class:list={[
        "shrink-0",
        compact ? "h-4.5 w-4.5" : isWide ? "h-5 w-16" : "h-5 w-5",
        currentColorClass
      ]}
    />
  )}
  {imageSource && (
    <img
      class:list={[
        compact ? "max-h-4 w-auto max-w-6" : isWide ? "max-h-5 w-auto max-w-[5.25rem]" : "h-6 w-6",
        icon === "opencode" ? "dark:invert" : ""
      ]}
      src={imageSource}
      alt=""
      loading="lazy"
      decoding="async"
    />
  )}
</span>
<span class="sr-only">{label}</span>
