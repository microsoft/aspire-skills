---
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const links = [
  { label: "Open on GitHub", href: "https://github.com/microsoft/aspire-skills", icon: "simple-icons:github" },
  { label: "Read Aspire docs", href: "https://aspire.dev", icon: "lucide:book-open" },
  { label: "Use the brand kit", href: "https://microsoft.github.io/aspire-brand/", icon: "lucide:palette" },
  { label: "File an issue", href: "https://github.com/microsoft/aspire-skills/issues", icon: "lucide:circle-dot" },
  { label: "Learn about Waza", href: "https://github.com/microsoft/waza", icon: "lucide:file-check-2" },
  { label: "Explore evals", href: "https://github.com/microsoft/aspire-skills/tree/main/evals", icon: "lucide:list-checks" }
] as const;
---

<footer class="mt-16 border-t border-slate-950/10 bg-white dark:border-white/10 dark:bg-[#0a0a14]">
  <div class="mx-auto w-full max-w-7xl px-5 py-10 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:items-start">
      <div>
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
          <img class="h-5 w-5" src={`${import.meta.env.BASE_URL}brand/aspire-logo-256.svg`} alt="" />
          Aspire skills
        </p>
        <p class="mt-3 max-w-md text-sm leading-7 text-slate-600 dark:text-slate-300">
          Agent skills that help AI coding tools understand Aspire projects, follow Aspire workflows, and surface deployment and diagnostics guidance.
        </p>
      </div>

      <nav aria-label="Footer links" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {links.map((link) => (
          <a class="group flex items-center gap-3 rounded-xl px-2 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-aspire-black dark:text-slate-300 dark:hover:bg-white/[0.06] dark:hover:text-white" href={link.href}>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-950/10 bg-white text-slate-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-300">
              <Icon name={link.icon} class="h-4 w-4" />
            </span>
            <span>{link.label}</span>
            <Icon name="lucide:arrow-up-right" class="ml-auto h-4 w-4 opacity-45 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100" />
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-slate-950/10 pt-5 text-xs text-slate-500 dark:border-white/10 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <a class="inline-flex items-center gap-2 font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 transition hover:text-aspire-purple dark:text-slate-300 dark:decoration-white/25 dark:hover:text-white" href="https://github.com/microsoft/aspire-skills/blob/main/LICENSE">
        <Icon name="lucide:scale" class="h-4 w-4" />
        MIT licensed
      </a>
      <p>© {year} Microsoft.</p>
    </div>
  </div>
</footer>
